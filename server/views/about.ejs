<%- include ./partials/header.ejs %>
<%- include ./partials/main_nav.ejs %>
<article class="text-center">
        <h1>About Me</h1>

        <section class="mx-auto" style="max-width:800px;">
            <h2>Hello!</h2>
            <p class="lead">
              My name D'Alo Farrington and I would like to welcome you to Rate My Flix! 
                This is a web application that allows users to rate and review movies.
                I created this application as a way to share my love of movies with others and to provide a platform for movie enthusiasts to connect and share their opinions.
                Some of my favorite movies include Sinners, Hunger Games: Ballad of Songbirds and Snakes, Spider-Man: Across the Spider-Verse, and What Happened to Monday.
                I enjoy watching movies of all genres, from action and adventure to romance and comerdy.
            </p>
        </section>

      <!--Carosel from Bootstrap-->
<div class="container mx-auto text-center py-3">
  <div id="carouselExample" class="carousel slide mx-auto" data-bs-ride="carousel">
    <div class="carousel-inner text-center py-4">
      <div class="carousel-item active">
        <img class="d-block mx-auto" src="/Asset/images/columbia.png" alt="Columbia Studios Logo" style="max-width:450px; height:auto">
      </div>
      <div class="carousel-item">
        <img class="d-block mx-auto" src="/Asset/images/Disney.png" alt="Disney Logo" style="max-width:550px; height:auto">
      </div>
      <div class="carousel-item">
        <img class="d-block mx-auto" src="/Asset/images/LionsGate.png" alt="Lions Gate Logo" style="max-width:550px; height:auto">
      </div>
      <div class="carousel-item">
        <img class="d-block mx-auto" src="/Asset/images/SonyPictures.png" alt="Sony Pictures Logo" style="max-width:550px; height:auto">
      </div>
      <div class="carousel-item">
        <img class="d-block mx-auto" src="/Asset/images/WarnerBros.png" alt="Warner Bros Logo" style="max-width:550px; height:auto">
      </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Next</span>
    </button>
  </div>
</div>
</article>

        

